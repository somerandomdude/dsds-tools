{
  "name": "dsds-tools",
  "version": "0.0.0",
  "private": true,
  "description": "DSDS tooling monorepo — one core for the Design System Documentation Spec, served over MCP (dsds-mcp) and the command line (dsds-cli).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "evaluate:local": "node scripts/evaluate-local-model.mjs",
    "evaluate:local:suite": "node scripts/evaluate-local-model-suite.mjs",
    "test": "npm run test:evaluation && npm test --workspaces",
    "test:evaluation": "node --test scripts/local-model-evaluation-core.test.mjs",
    "check:integrity": "npm run check:integrity --workspace dsds-mcp"
  },
  "license": "Apache-2.0",
  "author": "PJ Onori",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somerandomdude/dsds-tools.git"
  },
  "engines": {
    "node": ">=20"
  }
}
