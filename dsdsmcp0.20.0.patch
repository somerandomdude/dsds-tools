+  meta.configFile = filePath;
+  let fileConfig;
+  try {
+    fileConfig = normalizeFileConfig((await loadConfigFile(filePath)) ?? {}, dirname(filePath));
+  } catch (err) {
+    meta.configFileError = `failed to load ${filePath}: ${err.message}`;
+    return { ...envConfig, meta };
+  }
