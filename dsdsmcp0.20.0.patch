+  const envProvided = envProvidedKeys();
+  const merged = { ...envConfig };
+  for (const [key, value] of Object.entries(fileConfig)) {
+    if (!envProvided[key]) merged[key] = value;
+  }
+  return { ...merged, meta };
+}
